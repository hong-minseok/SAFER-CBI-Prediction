{
  "version": 4,
  "parameters": {
    "d_model": { "type": "categorical", "choices": [256, 512] },
    "num_layers": { "type": "int", "low": 3, "high": 4 },
    "dropout": { "type": "float", "low": 0.1, "high": 0.3 },
    "lr": { "type": "float", "low": 1e-4, "high": 5e-4, "log": true },
    "batch_size": { "type": "categorical", "choices": [256, 384, 512] },
    "focal_gamma": { "type": "float", "low": 1.0, "high": 2.5 }
  },
  "conditional": {
    "nhead": { "type": "categorical", "choices": [4, 8],
               "depends_on": "d_model", "filter": "divisible" }
  },
  "cv": { "n_folds": 5, "n_trials": 100 }
}
